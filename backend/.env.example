# Private server settings. Copy to backend/.env.local, never into a frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ADMIN_ORIGIN=http://127.0.0.1:5173
PORT=4101
TRUST_PROXY_CLIENT_IP=false
# Keep TLS verification enabled; use NODE_EXTRA_CA_CERTS with the repository CA if needed.
# Hosted changes always require separate authorization.
PATAG_ALLOW_HOSTED_MUTATIONS=false
# Optional one-time migration input: distinct email for exactly one conflicting legacy admin.
# Set in the process environment only after approving the planned identity separation.
# PATAG_LEGACY_ADMIN_EMAIL=
# Initial password setup uses process-only ADMIN_EMAIL and ADMIN_PASSWORD.
# Local-admin account selection/bypass is no longer supported.
