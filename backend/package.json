{
  "name": "patag-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "setup:storage": "node --env-file-if-exists=.env scripts/setup-storage.ts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
